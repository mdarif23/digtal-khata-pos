# ezPosStorefront — hosted storefront renderer environment.
# Copy to .env and adjust. Server-side only unless prefixed NEXT_PUBLIC_.

# Central backend the renderer talks to (internal token endpoints).
BACKEND_URL=http://localhost:3000
# Must match STOREFRONT_RENDERER_TOKEN on the backend.
STOREFRONT_RENDERER_TOKEN=ezpos-local-development-internal-token

# Base domain shopper subdomains live under (informational for dev hosts).
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=ezpos.store

# Local development convenience: when the browser host is localhost, resolve
# this subdomain instead (e.g. set to "abc-fashion" and visit localhost:3002).
#STOREFRONT_DEV_SUBDOMAIN=abc-fashion
