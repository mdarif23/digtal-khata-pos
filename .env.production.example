# Copy to `.env` (repo root) before `docker compose up`.
# NEVER commit the filled-in file.

# --- Postgres ---
POSTGRES_DB=ezpos
POSTGRES_USER=ezpos
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Backend ---
# openssl rand -base64 48
AUTH_JWT_SECRET=
CORS_ORIGINS=https://ezpos.com,https://app.ezpos.com
APP_URL=https://ezpos.com
BACKEND_URL=https://api.ezpos.com

# Payments — production REQUIRES sslcommerz (mock is refused at startup).
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

# Integration credentials encryption (WooCommerce) — openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Storefront API per-key rate limit (requests/minute). Default 600.
STOREFRONT_RATE_LIMIT_PER_MINUTE=600

# --- Hosted storefront platform ---
# Base domain tenant subdomains live under: <subdomain>.ezpos.store
STOREFRONT_BASE_DOMAIN=ezpos.store
# Shared secret for internal renderer/edge endpoints — openssl rand -base64 48
STOREFRONT_RENDERER_TOKEN=
# S3-compatible object storage (MinIO in docker-compose; use R2/S3 values in
# hosted deployments). S3_PUBLIC_BASE_URL is where browsers fetch images from
# (a CDN host in production).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ezpos-media
S3_ACCESS_KEY_ID=
# openssl rand -base64 32
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.ezpos.store
# Per-file upload cap in MB. Default 10.
MEDIA_MAX_UPLOAD_MB=10

# --- MinIO (docker-compose root credentials) ---
MINIO_ROOT_USER=
# openssl rand -base64 32
MINIO_ROOT_PASSWORD=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=ezPos <noreply@ezpos.com>

# Jobs
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=60

# --- Public origins (baked into the frontend builds) ---
API_ORIGIN=https://api.ezpos.com
POS_ORIGIN=https://app.ezpos.com
SITE_ORIGIN=https://ezpos.com
