# ezPosBackend environment configuration.
# Copy to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://user:password@localhost:5432/ezpos

# HS256 secret used to sign access tokens (required).
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Server-side policy overrides (optional; defaults shown).
TRIAL_DAYS=14
TRIAL_PLAN_SLUG=free-trial
# Ops-tunable rate-limit ceilings (requests per 15 min). Defaults: 20 auth, 60 refresh.
#AUTH_RATE_LIMIT_MAX=20
#REFRESH_RATE_LIMIT_MAX=60
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Set to "production" in production (enables Secure cookies).
NODE_ENV=development

# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# HTTP port for the backend (optional; defaults to 3000).
PORT=3000

# Number of trusted reverse-proxy hops in front of the server (optional).
# Set to 1 behind nginx / a load balancer so rate limiting sees real client
# IPs. Leave unset when the server is exposed directly.
# TRUST_PROXY=1

# --- Payments (Phase 5) ---
# "mock" (default; refused in production) or "sslcommerz".
PAYMENT_PROVIDER=mock
# Required when PAYMENT_PROVIDER=sslcommerz. Sandbox by default.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Public backend origin — the gateway IPN callback target.
BACKEND_URL=http://localhost:3000
# Required to connect WooCommerce stores (credentials are encrypted at rest).
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Storefront API per-key rate limit (requests/minute). Default 600.
STOREFRONT_RATE_LIMIT_PER_MINUTE=600

# --- Hosted storefront platform (website platform) ---
# Base domain tenant subdomains live under: <subdomain>.ezpos.store
STOREFRONT_BASE_DOMAIN=ezpos.store
# Shared secret for internal renderer/edge endpoints (/api/internal/*).
# Required in production; a deterministic dev fallback is used otherwise.
# openssl rand -base64 48
#STOREFRONT_RENDERER_TOKEN=
# S3-compatible object storage (MinIO locally via docker-compose).
# Leave the access keys empty to disable media uploads (dev default).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ezpos-media
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_PUBLIC_BASE_URL=http://localhost:9000/ezpos-media
#MEDIA_MAX_UPLOAD_MB=10
